        "encode_head_bf16",
        "normalize_score_row"
      ]
    },
    "oracle": {
      "centering": "Decode every selected oracle BF16 value as an exact dyadic, select the exact maximum over causal keys with lowest-index tie break, subtract exactly, then round centered values times 2^20 to nearest ties to even.",
